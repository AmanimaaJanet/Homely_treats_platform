# ===== Server =====
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://homely:homely@localhost:5432/homely?schema=public

# JWT secret — REQUIRED in production. The server refuses to start without it
# (NODE_ENV=production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the frontend (used for payment callback + email links)
CLIENT_URL=http://localhost:5173

# ===== Paystack (Ghana: MTN MoMo, AirtelTigo, Vodafone Cash, Cards) =====
# Test keys work with NO business documents — sign up free at https://dashboard.paystack.com
# Leave blank to run in "Simulated Payment" mode (orders marked paid locally for demoing).
# Paste your real keys here (test secret keys begin with "sk_test_", live with "sk_live_").
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ===== Email — Resend (https://resend.com) =====
# Free tier: 100 emails/day, 3000/month. Add & verify your sending domain.
# Leave blank to simulate: emails are printed to the server console instead of sent.
# Paste your real API key here (Resend keys begin with "re_").
RESEND_API_KEY=
EMAIL_FROM=Homely Treats <orders@homelytreats.gh>

# ===== WhatsApp — Meta WhatsApp Cloud API =====
# Free test phone number (1,000 conversations/month) — no business docs needed.
# https://developers.facebook.com → Create App → WhatsApp → get a test number.
# Leave blank to simulate: WhatsApp messages are printed to the server console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== SMS — Ghana-friendly options =====
# Provider: 'textbelt' or 'arkesel'. Arkesel is Ghana-based (free signup + trial credits) and is
# recommended for GH numbers — Textbelt's free tier is blocked for Ghana.
SMS_PROVIDER=textbelt
SMS_SENDER=HomelyTreats

# Textbelt (https://textbelt.com) — free tier: 1 SMS/day with key "textbelt"
TEXTBELT_API_KEY=textbelt

# Arkesel (https://sms.arkesel.com) — Ghana-based, free trial credits
ARKESEL_API_KEY=

# ===== Design-photo & product-photo storage =====
# Default: local disk (server/uploads). For Render/production use Cloudinary (free tier):
#   https://cloudinary.com → copy your cloud name + API key + API secret.
# NOTE: on Render the local disk is wiped on every deploy, so Cloudinary (or a
# persistent disk) is required in production — customer design photos must survive.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ===== Security extras (optional) =====
# Cloudflare Turnstile — free bot protection for register / forgot-password.
# https://dash.cloudflare.com → Turnstile → Add site. Leave blank to disable.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Max failed sign-ins per account before a temporary lock (per-IP limits also apply).
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15
